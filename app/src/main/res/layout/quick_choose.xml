<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter the money: "
        android:fontFamily="@font/sfheavy"
        android:textSize="16sp"
        android:layout_marginTop="20dp"
        android:layout_gravity="center" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="(Make sure to check all the friends)"
        android:fontFamily="@font/sflight"
        android:textSize="14sp"
        android:layout_marginTop="2dp"
        android:layout_gravity="center" />


    <EditText
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:id="@+id/price"
        android:fontFamily="@font/roboto_medium"
        android:textSize="16sp"
        android:layout_gravity="center"
        android:background="@drawable/border"
        android:hint="Price..."
        android:gravity="center"
        android:layout_marginTop="10dp"
        android:padding="10dp" />

    <CheckBox
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:textSize="14sp"
        android:text="Include me in the above price"
        android:fontFamily="@font/roboto_medium"
        android:id="@+id/includeMe" />

</LinearLayout>